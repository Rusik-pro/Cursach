# Переменные подхватывает Webpack (dotenv + EnvironmentPlugin). Префикс VITE_* оставлен для совместимости с CI и старыми инструкциями.
# Базовый URL API (без завершающего слэша не критично — клиент использует относительные пути)
VITE_API_URL=/api

# Включить MSW в браузере (демо без бэкенда). Для реального API установите false и настройте прокси CORS.
VITE_ENABLE_MSW=true

# Для GitHub Actions при деплое: VITE_BASE_PATH=/имя-репозитория/

# TheMealDB — внешний API (живая лента на главной). Обычно менять не нужно.
# VITE_THEMEALDB_BASE_URL=https://www.themealdb.com/api/json/v1/1
# Интервал опроса в мс (≥ 5000): обновление «в реальном времени» на клиенте
# VITE_THEMEALDB_REFRESH_MS=25000
